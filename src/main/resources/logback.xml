<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for the Library Management Application.
  - Console output for INFO and above
  - File output for DEBUG and above (optional, for debugging)
-->
<configuration>
    <!-- Console appender: logs to stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger: set to INFO so console output is clean -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

